# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no .env at all the system runs on the
# built-in payment simulator and the deterministic intent parser, so anyone
# can clone and run it without any credentials.
# ---------------------------------------------------------------------------

PORT=8787

# --- Razorpay test mode -----------------------------------------------------
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys,
# with the dashboard switched to TEST mode. Keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret you set when creating the webhook in the Razorpay dashboard.
# Without it, incoming webhooks are rejected rather than trusted blindly.
RAZORPAY_WEBHOOK_SECRET=

# Set to "true" to keep using the built-in simulator even with keys present.
# Useful for running the fault-injection demo against real credentials.
RAZORPAY_FORCE_SIMULATOR=false

# --- Optional: LLM intent parsing ------------------------------------------
# Any OpenAI-compatible chat completions endpoint works.
# Leave blank to use the deterministic parser, which needs no network at all.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Set to "true" to force the deterministic parser even when a key is present.
LLM_FORCE_HEURISTIC=false

# --- Public URL -------------------------------------------------------------
# Used to build the URLs advertised in the agent manifest and llms.txt.
PUBLIC_URL=http://localhost:8787
