{
  "name": "vyapaar-agent",
  "version": "1.0.0",
  "description": "Agentic commerce layer for Razorpay merchants: makes a merchant transactable by AI buyers, and grows the basket once they arrive. Every money action bounded, gated and explainable.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/catalog/seed.ts",
    "demo": "tsx src/demo/runDemo.ts",
    "test": "tsx src/tests/runTests.ts",
    "verify:ledger": "tsx src/demo/verifyLedger.ts",
    "verify:razorpay": "tsx src/demo/verifyRazorpay.ts"
  },
  "keywords": [
    "razorpay",
    "agentic-commerce",
    "ai-agents",
    "payments",
    "governance",
    "audit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
